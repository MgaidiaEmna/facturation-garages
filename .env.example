# ---------------------------------------------------------------------------
# Supabase — projet à créer sur https://supabase.com (Settings > API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé SERVICE ROLE : contourne le RLS. Serveur uniquement.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais committer, ne jamais l'importer
# dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# En local : http://localhost:3000 — en production : l'URL Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed du super administrateur (script db:seed, phase 1)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
